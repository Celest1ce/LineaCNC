{
  "name": "lineacnc",
  "version": "1.0.0",
  "description": "LineaCNC - Plateforme de contrôle d'imprimantes 3D",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "npm run dev:api & npm run dev:web",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run build:api && npm run build:web",
    "start": "npm run start --workspace=apps/api",
    "test:api": "npm run test --workspace=apps/api",
    "test:web": "npm run test --workspace=apps/web",
    "test": "npm run test:api && npm run test:web",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "keywords": [
    "3d-printing",
    "web-serial",
    "cnc",
    "react",
    "node",
    "express",
    "prisma",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "prettier": "^3.1.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0"
  }
}
